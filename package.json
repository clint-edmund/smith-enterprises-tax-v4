    "dev:seed:test-options": "tsx tools/atlas-seeder/src/test-seeder-options.ts",
    "dev:seed:office": "npm run dev:seed -- --profile=office",
    "dev:seed:dashboard": "npm run dev:seed -- --profile=dashboard",
