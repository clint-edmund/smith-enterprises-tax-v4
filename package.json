    "dev:seed:test-fixtures": "tsx tools/atlas-seeder/src/test-fixtures.ts",
    "dev:seed:preview-clients": "tsx tools/atlas-seeder/src/preview-clients.ts",
    "dev:seed:preview-returns": "tsx tools/atlas-seeder/src/preview-returns.ts",
    "dev:seed:preview-payments": "tsx tools/atlas-seeder/src/preview-payments.ts",
